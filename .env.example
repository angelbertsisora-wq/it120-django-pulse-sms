# Actual SMS via TextBee is the default (DEMO_MODE=false).
# Never commit a filled .env file.
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
TEXTBEE_API_KEY=your_textbee_api_key
TEXTBEE_DEVICE_ID=your_device_id
SECRET_KEY=django-insecure-change-me
DEBUG=True
# Optional offline simulation only — leave false for real SMS demonstrations.
DEMO_MODE=false
